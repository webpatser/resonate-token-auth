{
    "name": "webpatser/resonate-token-auth",
    "description": "Token-based subscription auth for Resonate: skip /broadcasting/auth for mobile and S2S clients with a JWT",
    "keywords": ["resonate", "websockets", "auth", "jwt", "pusher", "broadcasting"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Christoph Kempen",
            "email": "christoph@downsized.nl"
        }
    ],
    "require": {
        "php": "^8.5",
        "firebase/php-jwt": "^7.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "webpatser/resonate": "^0.4"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Webpatser\\ResonateTokenAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webpatser\\ResonateTokenAuth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webpatser\\ResonateTokenAuth\\TokenAuthServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
